# Copy to .env (never committed). The environment wins over this file.

# Postgres to keep the run in; tables are created on first start. Without it: files in --data.
# Hosted databases usually need ?sslmode=require (then TLS is used).
DATABASE_URL=postgres://user:password@localhost:5432/hl_copytrader

# Name of this run: runs with different settings can share the database.
RUN_ID=main

# Container only (start.sh): info API weight per minute, and more `run` options.
# API_WEIGHT=800
# EXTRA_ARGS=--start 2000

# Real orders for the golden list (see README, "Live"): the account's address and the key that
# signs for it (its own, or an API wallet approved for it). Testnet unless LIVE_NET=mainnet.
# LIVE_ACCOUNT=0x...
# LIVE_KEY=0x...
# LIVE_NET=testnet
